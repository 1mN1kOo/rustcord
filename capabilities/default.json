{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Discord remote access capability",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-list-sources",
    "allow-start-capture",
    "allow-stop-capture"
  ],
  "remote": {
    "urls": ["https://discord.com/*"]
  }
}
